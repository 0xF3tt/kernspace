{
  "topic": "infosec",
  "terms": [
    {
      "text": "CIA triad",
      "type": "term",
      "code": "CIA",
      "meaning": "Confidentiality, integrity, availability: the three goals in the US legal definition of infosec (44 U.S.C. 3552).",
      "fame": "iconic",
      "reference": "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title44-section3552&num=0&edition=prelim",
      "series": [
        "specimen",
        "catalog-card",
        "cutting-mat"
      ],
      "mat": {
        "slots": [
          "sink"
        ]
      }
    },
    {
      "text": "Confidentiality",
      "type": "term",
      "code": "C",
      "meaning": "Preserving authorized restrictions on access and disclosure, incl. personal privacy and proprietary information.",
      "fame": "iconic",
      "reference": "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title44-section3552&num=0&edition=prelim",
      "series": [
        "catalog-card",
        "specimen"
      ]
    },
    {
      "text": "Integrity",
      "type": "term",
      "code": "I",
      "meaning": "Guarding against improper modification or destruction; includes nonrepudiation and authenticity.",
      "fame": "iconic",
      "reference": "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title44-section3552&num=0&edition=prelim",
      "series": [
        "catalog-card",
        "specimen"
      ]
    },
    {
      "text": "Availability",
      "type": "term",
      "code": "A",
      "meaning": "Ensuring timely and reliable access to and use of information.",
      "fame": "iconic",
      "reference": "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title44-section3552&num=0&edition=prelim",
      "series": [
        "catalog-card",
        "specimen"
      ]
    },
    {
      "text": "AAA",
      "type": "term",
      "code": "AAA",
      "meaning": "Authentication, authorization, accounting: who you are, what you may do, and a record of what you did.",
      "fame": "iconic",
      "reference": "",
      "series": [
        "specimen",
        "cutting-mat"
      ],
      "mat": {
        "slots": [
          "control"
        ]
      }
    },
    {
      "text": "Defense in depth",
      "type": "term",
      "code": "",
      "meaning": "Layering independent controls so that the failure of any single one does not lead to compromise.",
      "fame": "iconic",
      "reference": "https://csrc.nist.gov/glossary/term/defense_in_depth",
      "series": [
        "cutting-mat",
        "catalog-card"
      ],
      "mat": {
        "slots": [
          "note"
        ],
        "as": "defense in depth"
      }
    },
    {
      "text": "Least Privilege · AC-6",
      "type": "id",
      "code": "AC-6",
      "meaning": "Grant only the access a task needs; a 1975 design principle and control AC-6 in NIST SP 800-53 Rev. 5.",
      "fame": "iconic",
      "reference": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "series": [
        "cutting-mat",
        "catalog-card",
        "specimen"
      ],
      "mat": {
        "slots": [
          "note"
        ],
        "as": "least privilege · AC-6"
      }
    },
    {
      "text": "Fail-safe defaults",
      "type": "term",
      "code": "",
      "meaning": "Base access on explicit permission, not exclusion: the default answer is deny. A 1975 design principle.",
      "fame": "niche",
      "reference": "The Protection of Information in Computer Systems (1975)",
      "series": [
        "catalog-card",
        "galley-proof"
      ]
    },
    {
      "text": "Complete mediation",
      "type": "term",
      "code": "",
      "meaning": "Check every access to every object for authority, not just the first one. A 1975 design principle.",
      "fame": "niche",
      "reference": "The Protection of Information in Computer Systems (1975)",
      "series": [
        "catalog-card"
      ]
    },
    {
      "text": "Open design",
      "type": "term",
      "code": "",
      "meaning": "The design should not be secret; security rests on protected keys, not on attackers' ignorance. 1975 principle.",
      "fame": "niche",
      "reference": "The Protection of Information in Computer Systems (1975)",
      "series": [
        "catalog-card",
        "galley-proof"
      ]
    },
    {
      "text": "Psychological acceptability",
      "type": "term",
      "code": "",
      "meaning": "Protection must be easy to use so people apply it routinely and correctly. A 1975 design principle.",
      "fame": "niche",
      "reference": "The Protection of Information in Computer Systems (1975)",
      "series": [
        "catalog-card"
      ]
    },
    {
      "text": "Security through obscurity",
      "type": "term",
      "code": "",
      "meaning": "Relying on secrecy of design or implementation as the main defense; corrected by the open design principle.",
      "fame": "iconic",
      "reference": "",
      "series": [
        "galley-proof",
        "catalog-card",
        "cutting-mat"
      ],
      "mat": {
        "slots": [
          "finding",
          "note"
        ],
        "as": "myth · obscurity"
      }
    },
    {
      "text": "Zero Trust Architecture",
      "type": "framework",
      "code": "NIST SP 800-207",
      "meaning": "NIST model (Aug 2020): no implicit trust from network location; every access is authenticated and authorized.",
      "fame": "iconic",
      "reference": "https://csrc.nist.gov/pubs/sp/800/207/final",
      "series": [
        "catalog-card",
        "cutting-mat"
      ],
      "mat": {
        "slots": [
          "note"
        ],
        "as": "zero trust · SP 800-207"
      }
    },
    {
      "text": "Castle-and-moat → zero trust",
      "type": "term",
      "code": "",
      "meaning": "Perimeter model (trusted inside, hostile outside) that zero trust drops: location grants no trust (SP 800-207).",
      "fame": "niche",
      "reference": "https://csrc.nist.gov/pubs/sp/800/207/final",
      "series": [
        "galley-proof",
        "catalog-card"
      ]
    },
    {
      "text": "Break glass",
      "type": "term",
      "code": "",
      "meaning": "Pre-approved emergency access account or procedure, used only when normal access fails, and always audited.",
      "fame": "niche",
      "reference": "",
      "series": [
        "cutting-mat",
        "catalog-card"
      ],
      "mat": {
        "slots": [
          "flow"
        ],
        "as": "break glass"
      }
    },
    {
      "text": "Security theater",
      "type": "term",
      "code": "",
